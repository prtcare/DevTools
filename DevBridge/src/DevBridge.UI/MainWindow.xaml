<Window x:Class="DevBridge.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DevBridge Operator Console"
        Width="1600" Height="900" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- ============ DASHBOARD-ONLY COMPACT STYLES / TEMPLATES ============ -->
        <!-- One action button. States: recommended (solid accent) / enabled (light) /
             disabled (grey). Enablement + recommendation come from the engine via the
             ViewModel — this template is pure display. -->
        <DataTemplate x:Key="ActionButtonTemplate">
            <Button Content="{Binding Label}"
                    Command="{Binding Command}"
                    CommandParameter="{Binding Key}"
                    IsEnabled="{Binding IsEnabled}"
                    ToolTip="{Binding Key}"
                    Margin="2,2">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#0D478E"/>
                        <Setter Property="Background" Value="#E4EFFA"/>
                        <Setter Property="BorderBrush" Value="#B7D4EF"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="8,2"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#C9E1F6"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Background" Value="#EFF1F4"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#E4E7EA"/>
                                            <Setter Property="Foreground" Value="#A6AFB8"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                    <Condition Binding="{Binding IsRecommended}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#1565C0"/>
                                <Setter Property="BorderBrush" Value="#0D478E"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>

        <!-- Compact two-line lifecycle pill (label + token). -->
        <DataTemplate x:Key="LifecyclePillTemplate">
            <Border Background="{Binding Background}" CornerRadius="3" Padding="7,2" Margin="2,2">
                <Border.ToolTip>
                    <ToolTip>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="{Binding Label, Mode=OneWay}"/><Run Text=" — "/><Run Text="{Binding DisplayToken, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="9.5" FontWeight="Bold"
                               Foreground="{Binding Foreground}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding DisplayToken}" FontSize="7.5"
                               Foreground="{Binding Foreground}" Opacity="0.9" Margin="0,1,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="GroupCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="CompactLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CompactValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="GovernancePill" TargetType="Border">
            <Setter Property="Background" Value="#ECF0F4"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="2,1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- mode band -->
            <RowDefinition Height="Auto"/> <!-- compact header -->
            <RowDefinition Height="*"/>    <!-- tab content -->
        </Grid.RowDefinitions>

        <!-- ===================== MODE BAND (DB-M12.3, always visible) ===================== -->
        <Border Grid.Row="0" Height="5" Background="{Binding ModeBannerBrush}"
                ToolTip="{Binding ModeBannerText}"/>

        <!-- ===================== COMPACT HEADER ===================== -->
        <Border Grid.Row="1" Background="{StaticResource HeaderBrush}" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="DEVBridge Operator Console" FontSize="14" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"
                           ToolTip="{Binding BackendRoot}"/>

                <!-- Mode chip — TRIAL vs REAL, colored, always visible -->
                <Border Grid.Column="1" Background="{Binding ModeBadgeBrush}" CornerRadius="3"
                        Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center"
                        ToolTip="{Binding ModeBannerText}">
                    <TextBlock Text="{Binding ModeBadgeText}" FontSize="10.5" FontWeight="Bold"
                               Foreground="White"/>
                </Border>

                <!-- DB-M12.3 explanatory mode text (truncates when narrow) -->
                <TextBlock Grid.Column="2" Text="{Binding ModeBannerText}" FontSize="10.5"
                           Foreground="#C9D6E2" Margin="12,0,14,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ModeBannerText}"/>

                <!-- Workbook availability -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="WB" FontSize="9" FontWeight="Bold" Foreground="#9FB0C1" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding WorkbookState}" FontSize="10.5" FontWeight="Bold"
                               Foreground="{Binding WorkbookStateBrush}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SheetCountText}" FontSize="10" Foreground="#9FB0C1"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="sheets" FontSize="9" Foreground="#6F8294" Margin="3,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Last consistency + last refresh / busy -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="CONSISTENCY" FontSize="9" FontWeight="Bold" Foreground="#9FB0C1" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LastConsistency}" FontSize="10.5" FontWeight="Bold"
                               Foreground="{Binding ConsistencyBrush}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ConsistencyAt}" FontSize="9.5" Foreground="#9FB0C1" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding BusyText}" Foreground="#FFD54F" FontSize="10" Margin="10,0,0,0"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Refresh + clock; BUILD <short-git-hash> shows the published build -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BuildLabel}" FontSize="9" FontWeight="SemiBold"
                               Foreground="#9FB0C1" VerticalAlignment="Center" Margin="0,0,10,0"
                               ToolTip="Published build commit (short git hash from devbridge-build.json)">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BuildLabel}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding LastRefreshTime}" Foreground="#9FB0C1" FontSize="9.5"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="REFRESH" Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}" Padding="10,3" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== CONTENT ===================== -->
        <TabControl Grid.Row="2" Margin="8,6,8,8" Background="Transparent" BorderThickness="0" Padding="0">

            <!-- ========== DASHBOARD (compact, no page scroll) ========== -->
            <TabItem Header="DASHBOARD">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- action bar -->
                        <RowDefinition Height="Auto"/> <!-- instruction strip -->
                        <RowDefinition Height="Auto"/> <!-- current task + lifecycle -->
                        <RowDefinition Height="Auto"/> <!-- governance strip -->
                        <RowDefinition Height="*"/>    <!-- live output / failures -->
                    </Grid.RowDefinitions>

                    <!-- ============ ACTION BAR — always visible ============ -->
                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="8,4">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PRIMARY" Style="{StaticResource GroupCaption}"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding PrimaryActions}"
                                              ItemTemplate="{StaticResource ActionButtonTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Grid>

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CYCLE" Style="{StaticResource GroupCaption}"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding LifecycleActions}"
                                              ItemTemplate="{StaticResource ActionButtonTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Grid>

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="REPORTS" Style="{StaticResource GroupCaption}"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding ReportActions}"
                                              ItemTemplate="{StaticResource ActionButtonTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Grid>

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="HUMAN GATES" Style="{StaticResource GroupCaption}"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding HumanGateActions}"
                                              ItemTemplate="{StaticResource ActionButtonTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Grid>

                            <!-- clipboard status (compact, hidden when empty / not applicable) -->
                            <TextBlock Margin="88,1,0,0" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ClipboardStatusText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ClipboardStatusText}" Value="NOT APPLICABLE">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="CLIPBOARD: "/>
                                <Run FontWeight="SemiBold" Text="{Binding ClipboardStatusText}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ============ INSTRUCTION STRIP (compact, color-coded) ============ -->
                    <Border Grid.Row="1" Margin="0,6,0,0" Padding="10,4" CornerRadius="4"
                            Background="{Binding InstructionBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="NEXT ACTION" FontSize="9" FontWeight="Bold" Foreground="White"
                                       Opacity="0.85" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Instruction}" FontSize="12.5" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Instruction}" TextWrapping="Wrap" MaxWidth="700"/>
                                            <TextBlock Text="{Binding InstructionSub}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Foreground="#D9E6F5"/>
                                        </StackPanel>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <Border Grid.Column="2" Background="#33FFFFFF" CornerRadius="3" Padding="8,2"
                                    VerticalAlignment="Center" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶ " FontSize="11" FontWeight="Bold" Foreground="White"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RecommendedLabel}" FontSize="11" FontWeight="Bold"
                                               Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ============ CURRENT TASK + LIFECYCLE ============ -->
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: current task — compact property grid -->
                        <Border Style="{StaticResource CardBorder}" Padding="10,6">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CURRENT TASK" Style="{StaticResource SectionHeader}" FontSize="11.5"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedAt}" FontSize="9"
                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="74"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="NODE" Style="{StaticResource CompactLabel}" Grid.Row="0"/>
                                    <TextBlock Grid.Column="1" Grid.Row="0" Margin="8,0,10,0"
                                               Text="{Binding NodeId}" Style="{StaticResource CompactValue}"
                                               ToolTip="{Binding NodeId}"/>

                                    <TextBlock Grid.Column="2" Grid.Row="0" Text="STATUS" Style="{StaticResource CompactLabel}"/>
                                    <TextBlock Grid.Column="3" Grid.Row="0" Margin="8,0,0,0"
                                               Text="{Binding Status}" Style="{StaticResource CompactValue}"
                                               ToolTip="{Binding Status}"/>

                                    <TextBlock Text="CHANGE" Style="{StaticResource CompactLabel}" Grid.Row="1" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" Margin="8,4,10,0"
                                               Text="{Binding ChangeId}" Style="{StaticResource CompactValue}"
                                               ToolTip="{Binding ChangeId}"/>

                                    <TextBlock Grid.Column="2" Grid.Row="1" Margin="0,4,0,0" Text="PREFLIGHT"
                                               Style="{StaticResource CompactLabel}"/>
                                    <TextBlock Grid.Column="3" Grid.Row="1" Margin="8,4,0,0"
                                               Text="{Binding PreflightVerdict}" Style="{StaticResource CompactValue}"
                                               ToolTip="{Binding PreflightVerdict}"/>

                                    <TextBlock Text="NEXT" Style="{StaticResource CompactLabel}" Grid.Row="2" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="1" Grid.Row="2" Margin="8,4,10,0" Grid.ColumnSpan="3"
                                               Text="{Binding NextAllowed}" Style="{StaticResource CompactValue}"
                                               ToolTip="{Binding NextAllowed}"/>

                                    <TextBlock Text="TASK" Style="{StaticResource CompactLabel}" Grid.Row="3" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="3" Margin="8,4,0,0"
                                               Style="{StaticResource CompactValue}" ToolTip="{Binding TaskName}"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding TaskName}"/>
                                        <Run Foreground="{StaticResource TextMutedBrush}" Text="  "/>
                                        <Run Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Phase}"/>
                                        <Run Foreground="{StaticResource TextSecondaryBrush}" Text=" · "/>
                                        <Run Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Layer}"/>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Right: lifecycle stages — compact pills -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="LIFECYCLE STAGES" Style="{StaticResource SectionHeader}" FontSize="11.5"/>
                                <ItemsControl ItemsSource="{Binding Stages}"
                                              ItemTemplate="{StaticResource LifecyclePillTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ============ GOVERNANCE STRIP (compact horizontal) ============ -->
                    <Border Grid.Row="3" Margin="0,6,0,0" Background="#F1F4F7"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="8,2">
                        <StackPanel>
                            <WrapPanel>
                                <Border Background="{Binding ModeBadgeBrush}" CornerRadius="3" Padding="7,2" Margin="2,1">
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="White">
                                        <Run Text="MODE: "/><Run Text="{Binding ModeBadgeText}"/>
                                    </TextBlock>
                                </Border>

                                <Border Style="{StaticResource GovernancePill}"
                                        ToolTip="{Binding GitObservedText}" Tag="{Binding HumanGitGuidanceText}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="GIT" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,1,5,0"/>
                                        <TextBlock Text="{Binding HumanGitStateText}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GovernancePill}" ToolTip="DB-M06 verification result from state/verification.json">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="M06" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,1,5,0"/>
                                        <TextBlock Text="{Binding VerificationResultText}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GovernancePill}" ToolTip="Claude review decision (DB-M08)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="CLAUDE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,1,5,0"/>
                                        <TextBlock Text="{Binding ClaudeResultText}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GovernancePill}"
                                        ToolTip="Roadmap fingerprint guard — DevBridge never edits roadmap structure.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ROADMAP" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,1,5,0"/>
                                        <TextBlock Text="{Binding RoadmapGuardText}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GovernancePill}" ToolTip="ChatGPT handoff zero-context gate (DB-M05)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="HANDOFF" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,1,5,0"/>
                                        <TextBlock Text="{Binding HandoffReadyText}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GovernancePill}" ToolTip="{Binding ModeCaption}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="M10" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,1,5,0"/>
                                        <TextBlock Text="{Binding M10EligibilityText}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GovernancePill}" ToolTip="Advisory periodic workbook review (DB-M11)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ADVISORY" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,1,5,0"/>
                                        <TextBlock Text="{Binding AdvisoryReviewText}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GovernancePill}" ToolTip="Retirement status of the temporary bridge">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="STATUS" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,1,5,0"/>
                                        <TextBlock Text="{Binding RetirementText}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <WrapPanel Margin="0,1,0,0">
                                <Border Style="{StaticResource GovernancePill}" ToolTip="Pre-DevBridge Nexus baseline captured at retirement/restart">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="PRE-BASELINE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,1,5,0"/>
                                        <TextBlock Text="{Binding PreBaselineText}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GovernancePill}" ToolTip="Human Git observed state (branch / head / merge / dirty)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="GIT OBSERVED" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,1,5,0"/>
                                        <TextBlock Text="{Binding GitObservedText}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource GovernancePill}"
                                        ToolTip="Human Git guidance — hover of the GIT chip above. This console has NO roadmap structural-edit controls and no auto git/merge.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="GUIDANCE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,1,5,0"/>
                                        <TextBlock Text="{Binding HumanGitGuidanceText}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- ============ BOTTOM REGION: failures / human action / residuals / live output ============ -->
                    <Grid Grid.Row="4" Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- failure -->
                            <RowDefinition Height="Auto"/> <!-- human action -->
                            <RowDefinition Height="Auto"/> <!-- residuals -->
                            <RowDefinition Height="*"/>    <!-- live command output -->
                        </Grid.RowDefinitions>

                        <!-- FAILURE banner -->
                        <Border Grid.Row="0" Margin="0,0,0,4" Background="#FBE9E9" BorderBrush="{StaticResource RedBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10,4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFailure}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⚠ FAILED" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{StaticResource RedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding FailureStage}" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FailureResult}" TextWrapping="Wrap" MaxWidth="700"/>
                                                <TextBlock Text="{Binding FailureRecommended}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding FailureTimestamp}" Margin="0,6,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                    <Run Text="Reason: "/><Run FontWeight="SemiBold" Text="{Binding FailureRecommended}"/>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- HUMAN ACTION banner (DB-M12.3, display only) -->
                        <Border Grid.Row="1" Margin="0,0,0,4" Background="#F1EAF8" BorderBrush="{StaticResource PurpleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10,4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasHumanAction}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="HUMAN ACTION" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{StaticResource PurpleBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding HumanActionType}" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding HumanActionReason}" TextWrapping="Wrap" MaxWidth="700"/>
                                                <TextBlock Text="{Binding HumanActionInstructions}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                <TextBlock FontFamily="Consolas" FontSize="11" Text="{Binding HumanActionEvidence}"
                                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                    <Run Text="Reason: "/><Run FontWeight="SemiBold" Text="{Binding HumanActionReason}"/>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- RESIDUAL OBSERVATIONS (collapsed) -->
                        <Border Grid.Row="2" Margin="0,0,0,4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasResiduals}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Expander Header="{Binding ResidualSummary, StringFormat=RESIDUAL OBSERVATIONS — {0}}" IsExpanded="False">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
                                    <ItemsControl ItemsSource="{Binding Residuals}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F0F4F7" CornerRadius="3" Padding="8,4" Margin="0,2">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Background="{StaticResource PurpleBrush}" CornerRadius="3" Padding="5,1">
                                                                <TextBlock Text="{Binding Severity}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Subject}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Blocking}" FontSize="8.5" Foreground="{StaticResource TextMutedBrush}"
                                                                       Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Expander>
                        </Border>

                        <!-- LIVE COMMAND OUTPUT — internally scrollable, bottom-pinned, bounded height -->
                        <Border Grid.Row="3" MaxHeight="340" VerticalAlignment="Bottom">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F7F9FB"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="5"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CommandPanelVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="LIVE COMMAND OUTPUT" Style="{StaticResource SectionHeader}" FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="{Binding CommandStatusBrush}" CornerRadius="3"
                                            Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CommandRunStatus}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding RunningCommandName}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding RunningCommandName}"/>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="{Binding CommandOutputSummary}" FontSize="10.5"
                                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock Text="{Binding ScriptOutput}" FontFamily="Consolas" FontSize="10.5"
                                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========== DEVELOPMENT FLOW ========== -->
            <TabItem Header="DEVELOPMENT FLOW">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <TextBlock Text="Governed Development Flow" Style="{StaticResource SectionHeader}" FontSize="16"/>
                        <TextBlock Text="TASK → PREFLIGHT → RESERVATION → CHATGPT → DEEPSEEK → VERIFICATION → CLAUDE → FIX LOOP → COMPLETION → CONTROL VALIDATION → DONE"
                                   Style="{StaticResource SectionCaption}" Margin="0,2,0,12" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding Stages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F7F9FB" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="14,10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#E4E8EC" CornerRadius="15" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StateText}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="{Binding Background}" CornerRadius="4" Padding="8,3"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StateText}" FontSize="9" FontWeight="Bold" Foreground="{Binding Foreground}"/>
                                            </Border>
                                            <TextBlock Grid.Column="3" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DisplayToken}" Value="CURRENT">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="← CURRENT STAGE"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== CURRENT TASK ========== -->
            <TabItem Header="CURRENT TASK">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Current Task Identity" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="{Binding SelectedAt}" Style="{StaticResource SectionCaption}" Margin="0,2,0,10"/>
                            <ItemsControl ItemsSource="{Binding CurrentTaskFields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource LabelText}"/>
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource ValueText}" Grid.Column="1" Margin="12,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Artifact Presence" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Live evidence in tasks\ — the engine derives state from these artifacts" Style="{StaticResource SectionCaption}" Margin="0,2,0,10"/>
                            <ItemsControl ItemsSource="{Binding Artifacts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Stage}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PresentText}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding PresentBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========== TASK HISTORY ========== -->
            <TabItem Header="TASK HISTORY">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Task history from logs\tasks\&lt;NODE-ID&gt;\&lt;CHANGE-ID&gt;\ — failed attempts are never hidden."
                               Style="{StaticResource SectionCaption}" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="26"
                              Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                              AlternatingRowBackground="#FAFBFD">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Node" Binding="{Binding NodeId}" Width="90"/>
                            <DataGridTextColumn Header="Task" Binding="{Binding TaskName}" Width="230"/>
                            <DataGridTextColumn Header="Change" Binding="{Binding ChangeId}" Width="120"/>
                            <DataGridTemplateColumn Header="Result" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Result}" FontWeight="Bold" Foreground="{Binding ResultBrush}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Started" Binding="{Binding StartedAt}" Width="120"/>
                            <DataGridTextColumn Header="Completed" Binding="{Binding CompletedAt}" Width="130"/>
                            <DataGridTextColumn Header="Preflight" Binding="{Binding Preflight}" Width="70"/>
                            <DataGridTextColumn Header="Verification" Binding="{Binding Verification}" Width="80"/>
                            <DataGridTextColumn Header="Claude" Binding="{Binding Claude}" Width="70"/>
                            <DataGridTextColumn Header="Workbook" Binding="{Binding Workbook}" Width="70"/>
                            <DataGridTextColumn Header="Build p/w/e" Binding="{Binding Build}" Width="90"/>
                            <DataGridTextColumn Header="Tests" Binding="{Binding Tests}" Width="80"/>
                            <DataGridTextColumn Header="Harness" Binding="{Binding Harness}" Width="60"/>
                            <DataGridTextColumn Header="Fixes" Binding="{Binding Fixes}" Width="45"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ========== TASK DETAIL ========== -->
            <TabItem Header="TASK DETAIL">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedDetailCaption}" Style="{StaticResource SectionCaption}" TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Content="OPEN TASK FOLDER" Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenFolderCommand}"
                                CommandParameter="{Binding SelectedHistory.Item.DetailDir}" Margin="12,0,0,6"/>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedDetail}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="26"
                              Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="120"/>
                            <DataGridTextColumn Header="Artifact" Binding="{Binding Label}" Width="190"/>
                            <DataGridTemplateColumn Header="Presence" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PresentText}" FontWeight="Bold" Foreground="{Binding PresentBrush}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="Missing artifacts read as NOT APPLICABLE — the UI never hides or fabricates evidence."
                               Style="{StaticResource SectionCaption}" Margin="0,6,0,0"/>
                </Grid>
            </TabItem>

            <!-- ========== CONTROL HEALTH ========== -->
            <TabItem Header="CONTROL HEALTH">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Workbook Liveness" Style="{StaticResource SectionHeader}"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="State" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding WorkbookState}" FontSize="15" FontWeight="Bold" Foreground="{Binding WorkbookStateBrush}" Margin="0,2,0,0"/>
                                        <TextBlock Text="Sheets" Style="{StaticResource LabelText}" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding SheetCountText}" Style="{StaticResource ValueText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                        <TextBlock Text="SHA-256" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding WorkbookSha}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Text="Read-only probe — the UI never edits the workbook." Style="{StaticResource SectionCaption}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                        <TextBlock Text="Open error (if any)" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding WorkbookError}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Backend Consistency Evidence" Style="{StaticResource SectionHeader}"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Last consistency" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding LastConsistency}" FontSize="15" FontWeight="Bold" Foreground="{Binding ConsistencyBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="Validated at (UTC)" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding ConsistencyAt}" Style="{StaticResource ValueText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                        <TextBlock Text="Open changes" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding OpenActiveChanges}" Style="{StaticResource ValueText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="14,0,0,0">
                                        <TextBlock Text="Open blockers" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding OpenBlockers}" Style="{StaticResource ValueText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Margin="14,0,0,0">
                                        <TextBlock Text="Open decisions" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding OpenDecisions}" Style="{StaticResource ValueText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Audit findings" Style="{StaticResource LabelText}" Margin="0,14,0,0"/>
                                <TextBlock Text="{Binding OpenAuditFindings}" Style="{StaticResource ValueText}" Margin="0,2,0,0"/>
                                <TextBlock Text="Known mirror gap" Style="{StaticResource LabelText}" Margin="0,14,0,0"/>
                                <TextBlock Text="{Binding KnownMirrorGap}" Style="{StaticResource ValueText}" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding EvidenceNote}" Style="{StaticResource SectionCaption}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="Open decisions and audit findings are shown as counts — they are NOT classified as blockers by the UI."
                                           Style="{StaticResource SectionCaption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- DB-M12.3 WORKBOOK HEALTH PANEL (read-only) -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Workbook Health &amp; Authority (DB-M12.3)" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Read-only. The console never writes the workbook directly — execution-state writes flow through the hardened DB-M12.2 backend commands only."
                                           Style="{StaticResource SectionCaption}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Canonical workbook" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding BackendRoot}" Style="{StaticResource ValueText}" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                        <TextBlock Text="Authority status" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding WorkbookAuthorityText}" Style="{StaticResource ValueText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                        <TextBlock Text="Writer busy state" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding WriterBusyText}" Style="{StaticResource ValueText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Last governed write" Style="{StaticResource LabelText}" Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding LastGovernedWriteText}" Style="{StaticResource ValueText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="The historical DB-M23 hash note is a resolved different-file-reference discrepancy (documented in state/workbook-authority-reconciliation.json) — it is NOT an active corruption warning."
                                           FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== PARALLEL CHANGES ========== -->
            <TabItem Header="PARALLEL CHANGES">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Active Changes ledger — backend evidence (DB-M11 extraction)" Style="{StaticResource SectionCaption}"/>
                        <TextBlock Text="{Binding ActiveCounts}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="14,0,0,0"/>
                        <TextBlock Text="snapshot" Style="{StaticResource SectionCaption}" Margin="6,0,0,0"/>
                        <TextBlock Text="{Binding ActiveTimestamp}" Style="{StaticResource SectionCaption}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Margin="0,8,0,8" ItemsSource="{Binding ActiveChanges}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="26"
                              Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                              AlternatingRowBackground="#FAFBFD">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Change ID" Binding="{Binding ChangeId}" Width="120"/>
                            <DataGridTextColumn Header="Node / Scope" Binding="{Binding NodeContext}" Width="260">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding NodeContext}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Worker / TS" Binding="{Binding Worker}" Width="90"/>
                            <DataGridTextColumn Header="Repository" Binding="{Binding RepositoryDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Activity" Binding="{Binding Activity}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Activity}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusLead}" Width="260">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding StatusLead}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Risk" Binding="{Binding RiskDisplay}" Width="70"/>
                            <DataGridTemplateColumn Header="Parallel Safe" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Classification}" FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#E65100"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Classification}" Value="Terminal">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{Binding ParallelEvidenceNote}" Style="{StaticResource SectionCaption}" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <!-- ========== AI ANALYTICS (DB-M26, SEPARATE_MODULE — read-only) ========== -->
            <TabItem Header="AI ANALYTICS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="AI Usage / Cost Dashboard (DB-M26)" Style="{StaticResource SectionHeader}"/>
                                    <Border Background="{StaticResource PurpleBrush}" CornerRadius="3" Padding="9,3"
                                            Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="SEPARATE_MODULE · READ-ONLY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="A safe read-only navigation entry to the DB-M26 analytics module. This tab only renders DB-M26's own recorded result (state/db-m26-result.json) and opens its design document. It contains no lifecycle logic, performs no provider/model execution, and never writes anything."
                                           Style="{StaticResource SectionCaption}" Margin="0,2,0,10" TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Implementation" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding AnalyticsImplementation}" Style="{StaticResource ValueText}" Margin="0,2,0,0"/>
                                        <TextBlock Text="Tests" Style="{StaticResource LabelText}" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding AnalyticsTests}" Style="{StaticResource ValueText}" Margin="0,2,0,0"/>
                                        <TextBlock Text="Scenarios" Style="{StaticResource LabelText}" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding AnalyticsScenarios}" Style="{StaticResource ValueText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                        <TextBlock Text="AUTO AI execution" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding AnalyticsAutoExecution}" Style="{StaticResource ValueText}" Margin="0,2,0,0"/>
                                        <TextBlock Text="Provider / model executed" Style="{StaticResource LabelText}" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding AnalyticsProviderModelExecuted}" Style="{StaticResource ValueText}" Margin="0,2,0,0"/>
                                        <TextBlock Text="Roadmap modification capability" Style="{StaticResource LabelText}" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding AnalyticsRoadmapCapability}" Style="{StaticResource ValueText}" Margin="0,2,0,0"/>
                                        <TextBlock Text="Git PR / merge capability" Style="{StaticResource LabelText}" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding AnalyticsGitPrMergeCapability}" Style="{StaticResource ValueText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                        <TextBlock Text="Paid API calls" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="{Binding AnalyticsPaidApiCalls}" Style="{StaticResource ValueText}" Margin="0,2,0,0"/>
                                        <TextBlock Text="Network calls" Style="{StaticResource LabelText}" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding AnalyticsNetworkCalls}" Style="{StaticResource ValueText}" Margin="0,2,0,0"/>
                                        <TextBlock Text="Workbook SHA-256 (current)" Style="{StaticResource LabelText}" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding AnalyticsWorkbookSha}" FontFamily="Consolas" FontSize="11" Style="{StaticResource ValueText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="OPEN DB-M26 DASHBOARD DESIGN DOCUMENT" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding OpenCommand}" CommandParameter="{Binding AnalyticsDesignDocPath}"
                                        HorizontalAlignment="Left" Margin="0,14,0,0" Padding="14,7"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
